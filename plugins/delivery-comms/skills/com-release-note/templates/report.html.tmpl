<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}}</title>
<style>
/* ===== 1. Design-system tokens (fallback first; project docs/ux/tokens.css follows and wins) ===== */
{{DESIGN_SYSTEM_CSS}}

/* ===== 2. A4 report layout (token-driven; never hard-codes colour) ===== */
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--font-sans, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif);
  color: var(--ink, #1a1a1a);
  background: var(--surface, #fff);
  font-size: 10.5pt;
  line-height: 1.5;
}
.report { max-width: 178mm; margin: 0 auto; padding: 2mm 0; }
.report code {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.9em;
}

/* --- Title block --- */
.report-kicker {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 8pt; text-transform: uppercase; letter-spacing: 0.14em;
  color: var(--accent, #3b6ef5); margin-top: 9mm; margin-bottom: 2.5mm;
}
.report-title { font-size: 21pt; font-weight: 700; line-height: 1.2; margin: 0 0 2mm; }
.report-framing { font-size: 10.5pt; color: var(--muted, #6b7280); font-style: italic; margin: 0 0 3mm; }
.report-meta {
  display: flex; flex-wrap: wrap; gap: 1.5mm 6mm;
  font-family: var(--font-mono, ui-monospace, monospace); font-size: 7.5pt;
  color: var(--muted, #6b7280);
  border-top: 1px solid var(--border, #d7dce3);
  border-bottom: 1px solid var(--border, #d7dce3);
  padding: 2mm 0; margin-bottom: 5mm;
}

/* --- Sections --- */
.section { margin-bottom: 5.5mm; }
.section-label {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 8pt; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em;
  color: var(--muted, #6b7280);
  display: flex; align-items: center; gap: 3mm; margin-bottom: 3.5mm;
}
.section-label::after { content: ""; flex: 1; border-top: 1px solid var(--border, #d7dce3); }
/* Never strand a section label at the foot of a page, away from its content. */
.section-label { break-after: avoid; page-break-after: avoid; }

/* --- Product cards (Tier 1) --- */
.product-card {
  background: var(--surface-2, #eef1f5);
  border: 1px solid var(--border, #d7dce3);
  border-radius: var(--card-radius, 12px);
  padding: 3.5mm 5mm; margin-bottom: 3.5mm;
  break-inside: avoid;
}
.product-name { font-size: 11.5pt; font-weight: 700; margin: 0 0 2.5mm; display: flex; align-items: baseline; gap: 2.5mm; }
.product-id {
  font-family: var(--font-mono, ui-monospace, monospace); font-size: 8pt; font-weight: 600;
  color: var(--accent-ink, #fff); background: var(--accent, #3b6ef5);
  border-radius: 999px; padding: 0.5mm 2.5mm;
}
.entry-list { list-style: none; margin: 0; padding: 0; }
.entry-list li { padding: 1mm 0; break-inside: avoid; }
.entry-list li + li { border-top: 1px solid var(--border, #d7dce3); }
.entry-ref {
  font-family: var(--font-mono, ui-monospace, monospace); font-size: 8pt; font-weight: 600;
  color: var(--accent, #3b6ef5); margin-right: 1.5mm;
}
.entry-label { font-weight: 600; }
.entry-audit {
  font-family: var(--font-mono, ui-monospace, monospace); font-size: 7.5pt;
  color: var(--muted, #6b7280); margin-left: 1.5mm;
}

/* --- Platform and engineering (Tier 2) --- */
.bucket-grid { display: grid; grid-template-columns: 1fr; gap: 3mm; }
.bucket {
  border: 1px solid var(--border, #d7dce3);
  border-radius: var(--card-radius, 12px);
  padding: 3mm 4mm; break-inside: avoid;
}

/* --- Breaking changes --- */
.breaking {
  border: 1px solid var(--border, #d7dce3);
  border-left: 1.2mm solid var(--danger, #d9534f);
  border-radius: var(--card-radius, 12px);
  background: var(--surface-2, #eef1f5);
  padding: 3.5mm 5mm; break-inside: avoid;
}
.breaking .entry-list li + li { border-top-color: var(--border, #d7dce3); }

/* --- Document footer --- */
.report-footer {
  margin-top: 4mm; padding-top: 2.5mm;
  break-inside: avoid;
  border-top: 1px solid var(--border, #d7dce3);
  font-family: var(--font-mono, ui-monospace, monospace); font-size: 7.5pt;
  color: var(--muted, #6b7280);
}
.report-footer .changelog { color: var(--ink, #1a1a1a); margin-bottom: 1mm; }
.report-footer .release-link { color: var(--ink, #1a1a1a); margin-bottom: 1mm; }
.report-footer .release-link a { color: var(--accent, #3b6ef5); text-decoration: none; }
.report-footer code { font-family: inherit; }

/* --- Print (also drives browser print-to-PDF fallback) --- */
/* Margins must match render_pdf.py's _PDF_MARGIN, or Chromium paginates
   against one box and prints into another (content bleeds into the margin). */
@page { size: A4; margin: 14mm 16mm 18mm; }
@media print {
  .report { padding: 0; max-width: none; }
}
</style>
</head>
<body>
<div class="report">
{{CONTENT}}
  <footer class="report-footer">{{FOOTER}}</footer>
</div>
</body>
</html>
